{
  "include": [
    "custom"
  ],
  "options": [
    {
      "name": "Show keybinds",
      "command": "foot -a show_binds nvim -R $HOME/.config/river/classic"
    },
    {
      "name": "Window >",
      "submenu": [
        {
          "name": "float / tile",
          "command": "riverctl toggle-float"
        },
        {
          "name": "fullscreen",
          "command": "riverctl toggle-fullscreen"
        },
        {
          "name": "close",
          "command": "riverctl close"
        },
        {
          "name": "to previous monitor",
          "command": "riverctl send-to-output previous"
        },
        {
          "name": "to next monitor",
          "command": "riverctl send-to-output next"
        }
      ]
    },
    {
      "name": "Layout >",
      "submenu": [
        {
          "name": "become master",
          "command": "riverctl zoom"
        },
        {
          "name": "master on the left",
          "command": "riverctl send-layout-cmd rivertile 'main-location left'"
        },
        {
          "name": "master on the right",
          "command": "riverctl send-layout-cmd rivertile 'main-location right'"
        },
        {
          "name": "master width >",
          "submenu": [
            {
              "name": "40%",
              "command": "riverctl send-layout-cmd rivertile 'main-ratio 0.4'"
            },
            {
              "name": "50%",
              "command": "riverctl send-layout-cmd rivertile 'main-ratio 0.5'"
            },
            {
              "name": "60%",
              "command": "riverctl send-layout-cmd rivertile 'main-ratio 0.6'"
            },
            {
              "name": "70%",
              "command": "riverctl send-layout-cmd rivertile 'main-ratio 0.7'"
            },
            {
              "name": "80%",
              "command": "riverctl send-layout-cmd rivertile 'main-ratio 0.8'"
            }
          ]
        },
        {
          "name": "one more master",
          "command": "riverctl send-layout-cmd rivertile 'main-count +1'"
        },
        {
          "name": "one master less",
          "command": "riverctl send-layout-cmd rivertile 'main-count -1'"
        }
      ]
    },
    {
      "name": "Session >",
      "submenu": [
        {
          "name": "restart hypridle",
          "command": "pkill -x hypridle; sleep 0.2; exec hypridle"
        },
        {
          "name": "stop hypridle (stay awake)",
          "command": "pkill -x hypridle"
        }
      ]
    },
    {
      "name": "Power >",
      "command": "$HOME/.local/bin/select_tool_json.py powermenu"
    }
  ]
}
