#!/bin/sh
# Both rivers read this file:
# - river-classic (0.3, has riverctl): ./classic
# - river 0.4+: only runs a separate window manager, start it here
if command -v riverctl >/dev/null; then
  . "$HOME/.config/river/classic"
else
  echo "river/init: no riverctl, and no window manager set up for river 0.4+" >&2
fi
