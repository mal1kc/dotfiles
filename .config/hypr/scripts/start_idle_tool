#!/bin/env dash

# swayidle starter script

if command -v hypridle >/dev/null; then
	hypridle
else
	swayidle -w \
		timeout 900 "$HOME/.config/hypr/scripts/lock" \
		timeout 1200 '
      hyprctl monitors | grep HDMI
      ret=$?
          
          if [ $ret -eq 0 ]	
      then
        hyprctl dispatch "hl.dsp.dpms({ monitor = \"DP-1\", action = \"disable\" })"
      else
        hyprctl dispatch "hl.dsp.dpms({ monitor = \"eDP-1\", action = \"disable\" })"
      fi

          systemctl suspend' \
		resume '
      hyprctl monitors | grep HDMI
      ret=$?

      if [ $ret -eq 0 ]	
      then
        hyprctl dispatch "hl.dsp.dpms({ monitor = \"DP-1\", action = \"enable\" })"
      else
        hyprctl dispatch "hl.dsp.dpms({ monitor = \"eDP-1\", action = \"enable\" })"
      fi
      ' \
		before-sleep "$HOME/.config/hypr/scripts/lock" \
		lock "$HOME/.config/hypr/scripts/lock"
fi
