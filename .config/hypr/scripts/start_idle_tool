#!/bin/env dash

# swayidle starter script

if command -v hypridle >/dev/null; then
	hypridle
else
	# screens off; sleep only with a battery
	swayidle -w \
		timeout 900 "$HOME/.config/hypr/scripts/lock" \
		timeout 1200 '
			hyprctl dispatch "hl.dsp.dpms({ action = \"disable\" })"
			for battery in /sys/class/power_supply/BAT*; do
				[ -e "$battery" ] && systemctl suspend && break
			done' \
		resume 'hyprctl dispatch "hl.dsp.dpms({ action = \"enable\" })"' \
		before-sleep "$HOME/.config/hypr/scripts/lock" \
		lock "$HOME/.config/hypr/scripts/lock"
fi
