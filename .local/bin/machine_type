#!/bin/sh
# Print "desktop" or "laptop".
# 1. .this_is_desktop / .this_is_laptop in the dotfiles repo
# 2. hostname containing one of them
# 3. desktop
# Both markers at once: warn on stderr, use the hostname, exit 2.

self=$(readlink -f -- "$0") || self=$0
repo=$(dirname -- "$(dirname -- "$(dirname -- "$self")")")

from_hostname() {
  name=$(hostnamectl hostname 2>/dev/null) || name=$(uname -n)
  case $(printf '%s' "$name" | tr '[:upper:]' '[:lower:]') in
  *laptop*) echo laptop ;;
  *) echo desktop ;;
  esac
}

if [ -e "$repo/.this_is_desktop" ] && [ -e "$repo/.this_is_laptop" ]; then
  echo "machine_type: both .this_is_desktop and .this_is_laptop are in $repo" >&2
  from_hostname
  exit 2
elif [ -e "$repo/.this_is_desktop" ]; then
  echo desktop
elif [ -e "$repo/.this_is_laptop" ]; then
  echo laptop
else
  from_hostname
fi
